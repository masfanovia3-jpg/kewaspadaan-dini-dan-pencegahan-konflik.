  <!-- ================= KUIS UTAMA ================= -->
  <section id="kuis" class="page">
    <div class="breadcrumb">Beranda / Kuis</div>
    <div class="page-title-wrap"><h1 class="page-title">Kuis KDPK</h1></div>
    <div class="quiz-box">

      <div id="kuisIntro">
        <p style="color:var(--muted);font-size:14.5px;">Kuis ini terdiri dari 20 pertanyaan seputar kewaspadaan dini, konflik sosial, dan pencegahannya. Silakan masukkan nama Anda untuk memulai.</p>
