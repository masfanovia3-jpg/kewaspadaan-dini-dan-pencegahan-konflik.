function renderMiniQuiz(id){
  var data = miniQuizData[id];
  var box = document.getElementById(id);
  var html = '<div class="case">'+data.case+'</div><div class="question">'+data.question+'</div>';
  data.options.forEach(function(opt){
    html += '<button class="mq-option" data-key="'+opt.k+'" onclick="jawabMiniQuiz(\''+id+'\',\''+opt.k+'\',this)">'+opt.k+'. '+opt.t+'</button>';
  });
  html += '<div class="mq-feedback" id="fb-'+id+'"></div>';
  box.innerHTML = html;
}
function jawabMiniQuiz(id, key, btn){
  var data = miniQuizData[id];
  var box = document.getElementById(id);
  var options = box.querySelectorAll('.mq-option');
  options.forEach(function(o){
    o.onclick = null;
    if(o.getAttribute('data-key') === data.correct){ o.classList.add('correct'); }
    else if(o === btn && key !== data.correct){ o.classList.add('wrong'); }
  });
  var fb = document.getElementById('fb-'+id);
  var benar = (key === data.correct);
  fb.className = 'mq-feedback show ' + (benar ? 'ok' : 'no');
  fb.innerHTML = '<strong>'+(benar ? 'Jawaban Benar!' : 'Jawaban Kurang Tepat.')+'</strong> Jawaban yang benar: <strong>'+data.correct+'</strong>. '+data.feedback;
}
Object.keys(miniQuizData).forEach(renderMiniQuiz);

/* ======================= KUIS UTAMA (20 SOAL) ======================= */
