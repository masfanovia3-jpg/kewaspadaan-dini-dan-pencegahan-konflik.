<script>
/* ======================= NAVIGATION ANTAR HALAMAN ======================= */
function showPage(id){
  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});
  document.getElementById(id).classList.add('active');
  closeAllDropdowns();
  window.scrollTo({top:0,behavior:'instant'});
}
function goTo(pageId, panelId){
  showPage(pageId);
  setTimeout(function(){
    var btn = document.querySelector('#'+pageId+' [data-panel="'+panelId+'"]');
    if(btn){
      selectTopic(btn, panelId);
    } else {
      var el = document.getElementById(panelId);
      if(el){ el.scrollIntoView({behavior:'smooth', block:'start'}); }
    }
  }, 60);
}
function toggleDropdown(key){
  var dd = document.getElementById('dd-'+key);
  var isOpen = dd.classList.contains('open');
  closeAllDropdowns();
  if(!isOpen){ dd.classList.add('open'); }
}
function closeAllDropdowns(){
  document.querySelectorAll('.dropdown').forEach(function(d){d.classList.remove('open');});
}
document.addEventListener('click', function(e){
  if(!e.target.closest('.menu-item')){ closeAllDropdowns(); }
});

/* ======================= NAVIGASI SUB MATERI (dalam satu halaman) ======================= */
function selectTopic(cardBtn, panelId){
  var cardsRow = cardBtn.closest('.topic-cards');
  var panelsWrap = cardsRow.nextElementSibling;
  cardsRow.querySelectorAll('.topic-card').forEach(function(c){ c.classList.remove('active'); });
  panelsWrap.querySelectorAll('.topic-panel').forEach(function(p){ p.classList.remove('active'); });
  cardBtn.classList.add('active');
  var panelEl = document.getElementById(panelId);
  if(panelEl){
    panelEl.classList.add('active');
    panelEl.scrollIntoView({behavior:'smooth', block:'start'});
  }
}

/* ======================= ACCORDION ======================= */
function toggleAccordion(btn){
  var wrap = btn.parentElement;
  var content = wrap.querySelector('.accordion-content');
  var plus = btn.querySelector('.plus');
  var open = content.classList.toggle('open');
  wrap.classList.toggle('expanded', open);
  plus.innerHTML = open ? '&minus;' : '+';
}

/* ======================= KUIS SINGKAT (satu kuis di akhir tiap materi) ======================= */
var miniQuizData = {
