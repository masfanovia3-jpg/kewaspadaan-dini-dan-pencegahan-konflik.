var namaPeserta = '';
var currentIndex = 0;
var jawabanPeserta = [];

function mulaiKuis(){
  var input = document.getElementById('namaPeserta');
  namaPeserta = input.value.trim() || 'Peserta';
  currentIndex = 0;
  jawabanPeserta = [];
  document.getElementById('kuisIntro').style.display = 'none';
  document.getElementById('kuisHasil').style.display = 'none';
  document.getElementById('kuisJalan').style.display = 'block';
  tampilkanSoal();
}

function tampilkanSoal(){
  var total = quizQuestions.length;
  var data = quizQuestions[currentIndex];
  document.getElementById('progressFill').style.width = ((currentIndex)/total*100)+'%';
  document.getElementById('progressLabel').textContent = 'Soal '+(currentIndex+1)+' dari '+total;
  document.getElementById('qText').textContent = (currentIndex+1)+'. '+data.q;
  var optsBox = document.getElementById('qOptions');
  optsBox.innerHTML = '';
  ['A','B','C','D'].forEach(function(key){
    var b = document.createElement('button');
    b.className = 'q-option';
    b.textContent = key+'. '+data.o[key];
    b.onclick = function(){ jawabSoal(key, b); };
    optsBox.appendChild(b);
  });
  var fb = document.getElementById('qFeedback');
  fb.className = 'q-feedback';
  fb.innerHTML = '';
  document.getElementById('nextBtn').style.display = 'none';
}

function jawabSoal(key, btn){
  var data = quizQuestions[currentIndex];
  var options = document.querySelectorAll('#qOptions .q-option');
  options.forEach(function(o){ o.disabled = true; o.onclick = null; });
  var benar = (key === data.c);
  options.forEach(function(o){
    var letter = o.textContent.charAt(0);
    if(letter === data.c){ o.classList.add('correct'); }
    else if(letter === key && !benar){ o.classList.add('wrong'); }
  });
  jawabanPeserta.push({q:data.q, chosen:key, correct:data.c, benar:benar, feedback:data.f, o:data.o});

  var fb = document.getElementById('qFeedback');
  fb.className = 'q-feedback show ' + (benar ? 'ok' : 'no');
  fb.innerHTML = '<div class="correct-answer">'+(benar ? 'Jawaban Benar!' : 'Jawaban Kurang Tepat.')+' Jawaban yang benar: '+data.c+'. '+data.o[data.c]+'</div>'+data.f;

  var nextBtn = document.getElementById('nextBtn');
  nextBtn.style.display = 'inline-block';
  nextBtn.textContent = (currentIndex === quizQuestions.length-1) ? 'Lihat Hasil' : 'Lanjut \u2192';
}

function soalBerikutnya(){
  if(currentIndex < quizQuestions.length-1){
    currentIndex++;
    tampilkanSoal();
  } else {
    tampilkanHasil();
  }
}

function tampilkanHasil(){
  document.getElementById('kuisJalan').style.display = 'none';
  document.getElementById('kuisHasil').style.display = 'block';
  var skor = jawabanPeserta.filter(function(j){return j.benar;}).length;
  var skor100 = skor*5;
  document.getElementById('namaHasil').textContent = namaPeserta;
  document.getElementById('skorAngka').textContent = skor100+'/100';

  /* Kirim hasil ke Google Spreadsheet lewat Apps Script.
     Hanya berjalan jika halaman ini dijalankan sebagai Web App Apps Script
     (google.script.run tidak tersedia saat dibuka sebagai artifact biasa). */
  if (typeof google !== 'undefined' && google.script && google.script.run) {
    google.script.run.simpanHasilKuis(namaPeserta, skor100, skor, quizQuestions.length);
  }

  var reviewBox = document.getElementById('reviewList');
  reviewBox.innerHTML = '';
  jawabanPeserta.forEach(function(j, idx){
    var div = document.createElement('div');
    div.className = 'review-item';
    var chosenText = j.o[j.chosen] || '(tidak dijawab)';
    var correctText = j.o[j.correct];
    div.innerHTML =
      '<div class="rq">'+(idx+1)+'. '+j.q+'</div>'+
      '<div class="ra '+(j.benar?'correct':'wrong')+'">Jawaban Anda: '+j.chosen+'. '+chosenText+'</div>'+
      (j.benar ? '' : '<div class="ra correct">Jawaban Benar: '+j.correct+'. '+correctText+'</div>')+
      '<div class="rf">'+j.feedback+'</div>';
    reviewBox.appendChild(div);
  });
}

function ulangiKuis(){
  document.getElementById('kuisHasil').style.display = 'none';
  document.getElementById('kuisIntro').style.display = 'block';
  document.getElementById('namaPeserta').value = '';
}
